# ============================================================
# Nexas backend — copy to .env for local work, and paste the
# same keys into Render → Environment for the deployed service.
# Never commit the filled-in version.
#
# Only two kinds of value belong here: secrets, and the URLs that
# differ between local and production. Everything else — deposit
# limits, the USD rate, the Supabase project URL and publishable
# key — is a constant and lives in src/config/env.js.
# ============================================================

# ---- runtime ----
NODE_ENV=development
PORT=8080
# Where the browser app lives; used to build return URLs.
# On Render this can be left unset: it falls back to the first CORS origin.
#   production: https://novibinary.com
APP_URL=http://localhost:5500
# Public URL of THIS service. Payment providers post callbacks here, so it
# must be reachable from the internet. On Render this can be left unset:
# it falls back to RENDER_EXTERNAL_URL, which Render sets for you.
API_URL=http://localhost:8080
# Comma-separated list of front ends allowed to call this API. A browser
# call from an origin that is not listed here never arrives, and the page
# reports it as a network failure — so a missing entry looks like an
# outage. One wildcard subdomain label is allowed, for preview deploys:
#   https://novibinary.com,https://www.novibinary.com,https://adminsite.novibinary.com
# The admin console is a separate host and needs its own entry, or the
# console loads and then cannot reach anything.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ---- Supabase ----
# The service-role key bypasses row level security. Server only.
# Settings → API → service_role. Paste it here, never anywhere else;
# if it ever reaches a browser bundle, rotate it immediately.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Paystack (card deposits) ----
# Dashboard → Settings → API Keys & Webhooks.
# Left blank on purpose: Paystack keys share a prefix with Stripe keys, so
# a realistic-looking placeholder is read as a real secret by GitHub push
# protection and the push is refused. Paste yours into .env only.
PAYSTACK_SECRET_KEY=

# ---- PayHero (M-Pesa STK push) ----
# Dashboard → API. Auth is HTTP Basic: either paste the ready-made token,
# or give the username and password and let the server build it.
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_BASIC_TOKEN=
# The payment channel the funds land in (from your PayHero dashboard).
PAYHERO_CHANNEL_ID=
# No callback secret here: it is derived from the service-role key and
# printed in the boot log. Copy it from there into the PayHero dashboard.

# ---- SMS on the VIP demo rail ----
# The demo M-Pesa handset sends a Safaricom-shaped confirmation text for
# every movement — deposit, payout, agent withdrawal, reversal — so a
# presentation shows the whole flow rather than a balance that changes by
# itself. Leave all of it blank and the rail behaves exactly as before,
# in silence; the boot log prints which gateway it will use, or why none.
#
# Two providers, and Celcom wins when both are set. Fill in whichever you
# have: Africa's Talking is the one you can have in a minute, Celcom is
# the registered sender a real demo should go out under.

# -- Celcom Africa. Portal → Developers / API. All three together. --
CELCOM_API_KEY=
CELCOM_PARTNER_ID=
# The sender ID Celcom has registered for this account, e.g. NOVI.
# It can never be MPESA: that sender belongs to Safaricom and Celcom will
# refuse it.
CELCOM_SHORTCODE=

# -- Africa's Talking. Dashboard → Settings → API Key. Both together. --
# The username decides which world the key belongs to. "sandbox" is their
# test app: messages are accepted and delivered to the simulator on their
# dashboard, never to a handset — useful for wiring this up, useless in
# front of a room. A live app's username sends for real.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
# Optional, and ignored on sandbox — sandbox has no registered sender IDs
# and refuses any that is sent, by accepting the request and delivering
# nothing. Live, an alphanumeric sender has to be applied for and approved
# by the networks first; until then the texts arrive from AFRICASTKNG,
# their shared shortcode, which is fine for a test and wrong for a demo
# where the message should read as coming from us.
AFRICASTALKING_SENDER_ID=

# Which SMS gateway to use when both are set: auto (Celcom first), africastalking, or celcom
SMS_PROVIDER=auto

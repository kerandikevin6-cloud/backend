# ============================================================
# Nexas backend — copy to .env for local work, and paste these
# into Render → Environment for the deployed service.
# Never commit the filled-in version.
# ============================================================

# ---- runtime ----
NODE_ENV=development
PORT=8080
# Comma-separated list of front ends allowed to call this API.
# In production list your real origins only — no wildcard.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Where the browser app lives; used to build OAuth and payment return URLs.
APP_URL=http://localhost:5500
# Public URL of THIS service. Payment providers post webhooks here, so it
# must be reachable from the internet (on Render: https://<service>.onrender.com).
API_URL=http://localhost:8080

# ---- Supabase ----
# Project URL and keys from Supabase → Project Settings → API.
SUPABASE_URL=https://avzuiwqkqyhsjanjwtrx.supabase.co
# The publishable (anon) key is safe in a browser. Used here for sign-in.
SUPABASE_ANON_KEY=sb_publishable_aGZeOzRTqbvY2P6NgEVliQ_d_rh_pvn
# The service-role key bypasses RLS. Server only. If this ever reaches a
# browser bundle, rotate it immediately.
# Settings -> API -> service_role. Paste it here, never anywhere else.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Paystack (card deposits, and payouts once transfers are enabled) ----
# Dashboard → Settings → API Keys & Webhooks.
# Left blank on purpose. Paystack keys share a prefix with Stripe keys, so
# a realistic-looking placeholder here is read as a real secret by GitHub
# push protection and the push is refused. Paste yours into .env instead.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Optional: the hosted payment page you already use. Left blank, the API
# creates a fresh transaction per deposit, which is what you want in
# production because it carries a reference we can reconcile.
PAYSTACK_PAYMENT_PAGE=

# ---- PayHero (M-Pesa STK push) ----
# Dashboard → API. The Basic token is base64(username:password); set either
# the token directly, or the username and password and let the server build it.
PAYHERO_BASE_URL=https://backend.payhero.co.ke/api/v2
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_BASIC_TOKEN=
# The payment channel the funds land in (from your PayHero dashboard).
PAYHERO_CHANNEL_ID=
# Shared secret you generate; appended to the callback URL so we can reject
# forged callbacks. PayHero does not sign its payloads.
PAYHERO_CALLBACK_SECRET=change-me-to-a-long-random-string

# ---- money rules ----
# Minor units (cents). 10000 = KES 100.00
MIN_DEPOSIT_MINOR=10000
MAX_DEPOSIT_MINOR=15000000
MIN_WITHDRAWAL_MINOR=100000
# Local currency per 1 USD, used to convert a deposit into the trading
# balance. Replace with a rates feed before you take real money.
USD_RATE_KES=129

# ---- misc ----
# Trust the proxy in front of the service so rate limiting sees real IPs.
TRUST_PROXY=1
LOG_LEVEL=info
